# Copy this file to .env.local and fill in real values.
# .env.local is git-ignored — never commit real keys.

# --- Contact form delivery (required before going live) ---------------------
# Until RESEND_API_KEY is set, form submissions are logged to the server
# console and nothing is emailed. The form still reports success so the flow
# can be tested locally.

# API key from https://resend.com
RESEND_API_KEY=

# The inbox that should receive enquiries.
CONTACT_TO=hello@vastisol.com

# Must be a sender address on a domain verified in Resend.
CONTACT_FROM=Vastisol Website <website@vastisol.com>
